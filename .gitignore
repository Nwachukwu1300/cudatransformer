# Data files (large)
/data/

# Stage 5's MovieLens-1M data is ignored EXCEPT movies.dat, which the deployed
# web app needs at runtime to turn predicted movie IDs into titles (171KB of
# titles/genres only -- ratings.dat, the 24MB file, is training-only and stays
# ignored). The ML-1M README travels with it: the dataset's terms allow
# redistribution provided that conditions notice stays intact.
# Same `/*` trick as the checkpoints below -- a trailing-slash directory ignore
# stops git descending into the directory, which would silently void the `!`.
stage5/data/*
!stage5/data/ml-1m/
stage5/data/ml-1m/*
!stage5/data/ml-1m/movies.dat
!stage5/data/ml-1m/README

# Checkpoints
stage4/checkpoints/

# Stage 5 checkpoints are ignored EXCEPT the four recommender artifacts, which
# the deployed web app needs at runtime (~6.8MB total -- small enough to ship
# in the repo rather than standing up separate artifact hosting).
# Note the `/*` rather than a trailing `/`: a trailing-slash directory ignore
# stops git descending into the directory at all, so the `!` negations below
# would be silently ignored.
stage5/checkpoints/*
!stage5/checkpoints/recommender_config.json
!stage5/checkpoints/recommender_tokenizer.json
!stage5/checkpoints/recommender_weights.npz
!stage5/checkpoints/recommender_training_info.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
.venv_stage7/
.venv_webapp/

# Playwright MCP browser automation artifacts
.playwright-mcp/

# Local data slice made for uploading to Colab (not meant to be committed)
tinystories_train_5mb.txt
